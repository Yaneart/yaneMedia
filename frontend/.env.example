# API
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Home server playback. Public Compose overrides this to false.
VITE_SERVER_TORRENT_ENABLED=true
# Set only after publication, for example:
# https://github.com/Yaneart/yaneCompanion/releases/download/v0.3.0
# Public Compose reads these values from the shell or the project-root .env file.
VITE_COMPANION_DOWNLOAD_BASE_URL=
VITE_COMPANION_DOWNLOAD_VERSION=0.3.0
