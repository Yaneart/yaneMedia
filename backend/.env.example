# Application
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://yanemedia:yanemedia@localhost:5432/yanemedia
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
PASSWORD_RESET_MIN_RESPONSE_MS=500
# Optional: otherwise a process-local signing key is generated.
# CURSOR_SECRET=

# Email
RESEND_API_KEY=
MAIL_FROM="yaneMedia <onboarding@resend.dev>"

# Local assets
MEDIA_ASSETS_ROOT=./storage/media-assets
MEDIA_ASSET_CLEANUP_GRACE_DAYS=30
PROFILE_ASSETS_ROOT=./storage/profile-assets
PROFILE_ASSET_CLEANUP_GRACE_HOURS=24

# Media providers (server only)
TMDB_API_KEY=
MEDIA_ENGINE_SHIKIMORI_USER_AGENT=yaneMedia/1.0 (contact: you@example.com)
KODIK_API_KEY=
FILMIX_API_KEY=

# Torrent streaming. Compose supplies the private engine URL and secret-file paths.
TORRENT_STREAMING_ENABLED=false
# TORRSERVER_BASE_URL=http://torrserver:8090
# TORRSERVER_USERNAME_FILE=/run/secrets/torrserver_username
# TORRSERVER_PASSWORD_FILE=/run/secrets/torrserver_password
# TORRENT_IDEMPOTENCY_SECRET_FILE=/run/secrets/torrent_idempotency
TORRSERVER_CONNECT_TIMEOUT_MS=3000
TORRSERVER_HEADERS_TIMEOUT_MS=30000
TORRSERVER_BODY_TIMEOUT_MS=30000
TORRSERVER_METADATA_TIMEOUT_MS=120000

# Torrent discovery. Compose supplies the private Prowlarr URL and API-key path.
# PROWLARR_BASE_URL=http://prowlarr:9696
# PROWLARR_API_KEY_FILE=/run/secrets/prowlarr_api_key
PROWLARR_TIMEOUT_MS=10000
